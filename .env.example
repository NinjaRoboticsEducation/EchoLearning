# ==========================================
# Echo Learning - Environment Configuration
# ==========================================
# Copy this file to .env to customize local server endpoints and options:
#   cp .env.example .env

# --- Local LLM Server (llama-server) ---
# Default port for llama-server OpenAI-compatible API
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL_NAME=qwen3.5-9b
LLAMA_MODEL_PATH=models/Qwen3.5-9B-Q6_K.gguf

# --- Local Speech-to-Text Server (whisper-server) ---
# Default port for whisper.cpp server
WHISPER_SERVER_URL=http://127.0.0.1:8081
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo.bin

# --- Service Ports ---
# ADK FastAPI Backend server port
API_PORT=3000

# React Frontend dev server port
FRONTEND_DEV_PORT=5173

# --- Optional Cloud Fallback (Legacy) ---
# Only needed if running legacy dev:legacy mode
# GEMINI_API_KEY=your_gemini_api_key_here
